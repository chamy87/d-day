# ── Supabase (new API-key system: publishable + secret) ──────────────────────
# Dashboard → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PROJECT_ID=
# sb_publishable_… — safe for the browser, RLS enforced
NEXT_PUBLIC_SUPABASE_KEY=
# sb_secret_… — server-only, bypasses RLS. Never expose to the client.
NEXT_SECRET_SUPABASE_KEY=
# Legacy JWT service-role key — unused; kept only if some tool still needs it.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres/API connection for migrations & scripts
SUPABASE_DB_API_URL=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Token with repo scope, used for pushing this repo.
GITHUB_TOKEN=

# ── Vercel (d-day project — separate from every other project) ───────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ── Sentry ───────────────────────────────────────────────────────────────────
# From sentry.io → Project Settings → Client Keys (DSN). SDK no-ops when empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time secret for source map upload (Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Supabase direct Postgres (for migrations: supabase db push) ──────────────
# Dashboard → Connect → Session pooler URI (postgresql://…)
SUPABASE_DB_URL=

# ── Cron protection ──────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/* routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Data sources (no keys required) ──────────────────────────────────────────
# Sleeper, nflverse, FantasyFootballCalculator, FantasyCalc, and Boris Chen
# are all public/keyless.
